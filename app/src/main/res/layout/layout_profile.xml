<?xml version="1.0" encoding="utf-8"?>
<!-- @author 雾晚 --><!-- Based on: https://github.com/android/platform_frameworks_base/blob/505e3ab/core/res/res/layout/simple_list_item_2.xml -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/ui_card_gap"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/profile_card_corner_radius">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/content_lin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/profile_title_area"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/profile_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="24dp"
                        android:textSize="@dimen/ui_text_title"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none"
                        android:lineBreakStyle="loose"
                        android:lineBreakWordStyle="phrase"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textStyle="bold"
                        tools:text="@string/profile_name" />

                    <TextView
                        android:id="@+id/profile_selection_label"
                        android:importantForAccessibility="no"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ui_space_small"
                        android:textSize="@dimen/ui_text_caption"
                        android:textColor="?attr/primaryOrTextPrimary"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="@string/ui_profile_selected"
                        tools:visibility="visible" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/edit"
                    android:layout_width="@dimen/ui_touch_target"
                    android:layout_height="@dimen/ui_touch_target"
                    android:layout_gravity="top"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/edit"
                    android:focusable="true"
                    android:padding="12dp"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_image_edit" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/double_column_menu"
                    android:layout_width="@dimen/ui_touch_target"
                    android:layout_height="@dimen/ui_touch_target"
                    android:layout_gravity="center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/more"
                    android:focusable="true"
                    android:padding="12dp"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_baseline_more_vert_24" />

                <LinearLayout
                    android:id="@+id/share"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/more"
                    android:focusable="true"
                    android:visibility="gone"
                    android:nextFocusLeft="@+id/container">

                    <LinearLayout
                        android:id="@+id/share_layer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/shareIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:srcCompat="@drawable/ic_baseline_more_vert_24" />
                    </LinearLayout>

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/remove"
                    android:layout_width="@dimen/ui_touch_target"
                    android:layout_height="@dimen/ui_touch_target"
                    android:layout_gravity="top"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/delete"
                    android:focusable="true"
                    android:padding="12dp"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_action_delete" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/profile_details_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/profile_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="false"
                    android:breakStrategy="simple"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:scrollHorizontally="false"
                    tools:text="@string/server_address"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:id="@+id/traffic_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="@string/traffic"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="?android:attr/textColorSecondary" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/profile_status_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start"
                android:baselineAligned="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/profile_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textSize="@dimen/ui_text_caption"
                    android:textStyle="bold"
                    tools:text="VMESS" />

                <TextView
                    android:id="@+id/profile_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ui_space_small"
                    android:gravity="start"
                    android:textSize="@dimen/ui_text_body"
                    android:breakStrategy="simple"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="?android:textColorSecondary" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:id="@+id/selected_indicator"
            android:layout_width="@dimen/profile_card_selected_bar_width"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="?attr/selectedColorPrimary"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
