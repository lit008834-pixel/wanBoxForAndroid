<?xml version="1.0" encoding="utf-8"?>
<!-- @author 雾晚 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/main_list_padding_bottom">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 本地备份部分 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/ui_page_padding"
            android:clickable="false"
            android:focusable="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ui_form_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/backup_local"
                        android:textAppearance="?attr/textAppearanceHeadline6" />

                    <CheckBox
                        android:id="@+id/backup_configurations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="true"
                        android:text="@string/backup_groups_and_configurations" android:minHeight="@dimen/ui_touch_target" />

                    <CheckBox
                        android:id="@+id/backup_rules"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/backup_rules" android:minHeight="@dimen/ui_touch_target" />

                    <CheckBox
                        android:id="@+id/backup_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/backup_settings" android:minHeight="@dimen/ui_touch_target" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/backup_summary"
                        android:textAppearance="?attr/textAppearanceBody2"
                        android:textColor="?android:attr/textColorSecondary" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_form_padding"
                    android:layout_marginEnd="@dimen/ui_form_padding"
                    android:layout_marginTop="@dimen/ui_space_medium"
                    android:layout_marginBottom="@dimen/ui_space_medium"
                    android:orientation="vertical">

                    <!-- 本地备份部分的按钮 -->
                    <Button
                        android:id="@+id/action_share"
                        style="@style/Widget.WanBox.Ui.SecondaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cornerRadius="@dimen/button_corner_radius"
                        android:text="@string/share"
 />

                    <Button
                        android:id="@+id/action_export"
                        style="@style/Widget.WanBox.Ui.PrimaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cornerRadius="@dimen/button_corner_radius"
                        android:text="@string/action_export_file"
 />

                    <Button
                        android:id="@+id/action_import_file"
                        style="@style/Widget.WanBox.Ui.SecondaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cornerRadius="@dimen/button_corner_radius"
                        android:text="@string/action_import_file"
 />

                    <Button
                        android:id="@+id/action_import_throne_desktop"
                        style="@style/Widget.WanBox.Ui.SecondaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cornerRadius="@dimen/button_corner_radius"
                        android:text="@string/action_import_throne_desktop"
 />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- WebDAV 备份部分 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/ui_page_padding"
            android:clickable="false"
            android:focusable="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ui_form_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/backup_webdav"
                        android:textAppearance="?attr/textAppearanceHeadline6" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_form_padding"
                    android:layout_marginEnd="@dimen/ui_form_padding"
                    android:layout_marginTop="@dimen/ui_space_medium"
                    android:layout_marginBottom="@dimen/ui_space_medium"
                    android:orientation="vertical">

                    <!-- WebDAV 备份部分的按钮 -->
                    <Button
                        android:id="@+id/webdav_settings"
                        style="@style/Widget.WanBox.Ui.SecondaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cornerRadius="@dimen/button_corner_radius"
                        android:text="@string/webdav_settings"
 />

                    <Button
                        android:id="@+id/backup_to_webdav"
                        style="@style/Widget.WanBox.Ui.PrimaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cornerRadius="@dimen/button_corner_radius"
                        android:text="@string/backup_to_webdav"
 />

                    <Button
                        android:id="@+id/restore_from_webdav"
                        style="@style/Widget.WanBox.Ui.SecondaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cornerRadius="@dimen/button_corner_radius"
                        android:text="@string/restore_from_webdav"
 />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
